// ============================================================
// Static assets — base64-embedded so they ship with the script.
// (clasp does not push binary files to Apps Script, so the logo
//  must live here as a data URI.)
// ============================================================

// LUSU logo. Resized from src/assets/LUSU logo centered_one colour.png
// to 256px on the long edge via `sips -Z 256`, then base64-encoded.
function logoDataUri() {
  return 'data:image/png;base64,';
}
